{
  "name": "dsh-conversation-companion",
  "version": "0.5.0-beta.5",
  "private": false,
  "description": "根据对话生成简短的下一句建议，并将 AI 回复整理为通俗摘要。支持候选切换、Tab 填入、临时收起，以及可拖动、可编辑的摘要浮窗。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "db.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.en.md",
    "PRIVACY.md",
    "CHANGELOG.md",
    "TESTING.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "engines": {
    "dsh": "0.2.1-rc.3"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "prompt",
    "conversation"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check index.js && node --check client.js"
  },
  "author": {
    "name": "leo",
    "url": "https://github.com/tula-liuxin"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tula-liuxin/dsh-conversation-companion.git"
  },
  "homepage": "https://github.com/tula-liuxin/dsh-conversation-companion#readme",
  "bugs": {
    "url": "https://github.com/tula-liuxin/dsh-conversation-companion/issues"
  }
}
